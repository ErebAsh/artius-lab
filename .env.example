# ═══════════════════════════════════════════════════════════════════
#  ARTIUS LAB - UNIFIED ROOT ENVIRONMENT CONFIGURATION (.env.example)
# ═══════════════════════════════════════════════════════════════════

# ── 1. Backend Server & AI Config ──────────────────────────────────
# Groq Cloud API Key: Get free key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ── 2. Backend Security & JWT ──────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
ENCRYPTION_MASTER_KEY=your_fernet_key_here # Optional: for encrypting personal user API keys

# ── 3. Frontend Server Proxy Config (Server-only) ──────────────────
# Internal backend URL that Next.js rewrites to via /api/*
BACKEND_URL=http://127.0.0.1:8000

# ── 4. Supabase & Google Authentication (Server-only) ──────────────
# Get these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
